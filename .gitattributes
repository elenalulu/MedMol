# Normalize line endings across platforms
* text=auto

# Always LF for code & config
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
